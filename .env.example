PORT=7000

# Telegram: token from @BotFather, chat id of the group the bot was added to
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHAT_ID=replace-me

# Claude (Anthropic)
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_MODEL=claude-opus-5-5

# Instagram (Meta Graph API). After npm run instagram:setup the token becomes permanent
INSTAGRAM_ACCESS_TOKEN=replace-me
INSTAGRAM_BUSINESS_ID=replace-me
META_APP_ID=replace-me
META_APP_SECRET=replace-me
