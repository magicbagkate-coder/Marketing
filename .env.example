PORT=7000

# Telegram: token from @BotFather, chat id of the group the bot was added to
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_CHAT_ID=replace-me

# Claude (Anthropic)
ANTHROPIC_API_KEY=replace-me
ANTHROPIC_MODEL=claude-opus-5-5
# Content assistant: video reviews use the strong model, ideas and scripts the cheaper one
ANTHROPIC_MODEL_EVALUATE=claude-opus-5-5
ANTHROPIC_MODEL_CREATIVE=claude-sonnet-5-5
# Scripts (the main product of the assistant) are written by the strong model
ANTHROPIC_MODEL_SCRIPT=claude-opus-5-5

# Telegram user ids allowed to use the assistant, comma separated (everyone can send /id to learn theirs)
TELEGRAM_ALLOWED_USER_IDS=

# Speech recognition for video reviews (OpenAI transcription). Without a key only picture and text are reviewed
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Instagram (Meta Graph API). After npm run instagram:setup the token becomes permanent
INSTAGRAM_ACCESS_TOKEN=replace-me
INSTAGRAM_BUSINESS_ID=replace-me
META_APP_ID=replace-me
META_APP_SECRET=replace-me
