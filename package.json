{
  "name": "magicbag-agent",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "test": "jest",
    "digest:now": "node dist/scripts/run-digest.js",
    "instagram:setup": "node dist/scripts/setup-instagram.js"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": { "^.+\\.ts$": "ts-jest" },
    "moduleNameMapper": { "^@/(.*)$": "<rootDir>/$1" },
    "testEnvironment": "node"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^12.0.2",
    "dotenv": "^16.4.5",
    "fast-xml-parser": "^5.11.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^11.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
